
{% if cart.item_count > 0 %}
  <div class="h-[100px] md:h-[150px] flex items-center px-4 md:px-8 border-b border-gray-100">
    <a href="{{ routes.root_url }}" class="block">
      <img src="{{ 'Logo.png' | asset_url }}" alt="logo" class="h-auto max-w-[100px] md:max-w-[184px] object-contain">
    </a>
  </div>

  <div class="flex p-4 md:p-8 items-center justify-between font-montserrat">
    <div id="header-mobile" class="flex items-center gap-6">
      <button id="back-btn" class="text-body-sm text-gray-500 cursor-pointer hover:text-black transition-colors">Back</button>
      <h3 class="text-xl md:text-2xl font-semibold">Your Cart</h3>
    </div>
    <button id="continue-shopping" class="text-body-sm text-gray-500 cursor-pointer hidden md:block hover:text-black transition-colors">
      Continue Shopping
    </button>
  </div>

  <main class="w-full px-4 md:px-8 pb-16 font-montserrat">
    <div class="flex flex-col lg:flex-row gap-12 lg:items-start">
      
      <div class="w-full lg:w-3/5 flex flex-col">
        
        <div class="hidden md:flex justify-between w-full border-b border-gray-200 pb-4 mb-4">
          <p class="text-gray-500 font-medium uppercase tracking-wider text-xs">Order Summary</p>
          <div class="flex items-center justify-between w-1/2 max-w-[400px]">
            <p class="text-gray-500 font-medium uppercase tracking-wider text-xs w-1/3 text-center">Price</p>
            <p class="text-gray-500 font-medium uppercase tracking-wider text-xs w-1/3 text-center">Quantity</p>
            <p class="text-gray-500 font-medium uppercase tracking-wider text-xs w-1/3 text-right">Total</p>
          </div>
        </div>

        <div class="flex flex-col division-y division-gray-200">
          {% for item in cart.items %}
            
            <div class="hidden md:flex justify-between items-center py-6 border-b border-gray-100 cart-item-row" data-item-key="{{ item.key }}">
              <div class="w-1/2 flex gap-4 items-center">
                <img src="{{ item.image | image_url: width: 120 }}" alt="{{ item.title | escape }}" class="w-[80px] h-[100px] object-cover">
                <div>
                  <h4 class="font-semibold text-gray-900 text-base mb-1">{{ item.product.title }}</h4>
                  {% unless item.variant.title == 'Default Title' %}
                    <p class="text-xs text-gray-400">{{ item.variant.title }}</p>
                  {% endunless %}
                  <button type="button" class="cart-remove text-xs text-red-500 mt-2 underline cursor-pointer hover:text-red-700">Remove</button>
                </div>
              </div>
              
              <div class="flex items-center justify-between w-1/2 max-w-[400px]">
                <p class="text-body-lg w-1/3 text-center">{{ item.price | money }}</p>
                
                <div class="w-1/3 flex justify-center">
                  <div class="bg-[#D1D9CF] flex items-center rounded-sm">
                    <button type="button" class="qty-btn w-8 h-8 flex items-center justify-center text-sm font-semibold text-gray-700 hover:bg-black/5" data-action="decrease">−</button>
                    <span class="text-sm font-medium text-gray-800 min-w-[24px] text-center">{{ item.quantity }}</span>
                    <button type="button" class="qty-btn w-8 h-8 flex items-center justify-center text-sm font-semibold text-gray-700 hover:bg-black/5" data-action="increase">+</button>
                  </div>
                </div>
                
                <p class="line-total text-body-lg font-semibold w-1/3 text-right">{{ item.final_line_price | money }}</p>
              </div>
            </div>

            <div class="flex md:hidden gap-4 py-4 border-b border-gray-100 items-start cart-item-row" data-item-key="{{ item.key }}">
              <div class="relative flex-shrink-0">
                <img src="{{ item.image | image_url: width: 200 }}" alt="{{ item.title | escape }}" class="w-[100px] h-[130px] object-cover">
                <span class="absolute top-1.5 right-1.5 bg-white text-black text-[10px] w-6 h-6 rounded-full flex items-center justify-center font-bold shadow-sm">
                  {{ item.quantity }}
                </span>
              </div>

              <div class="flex-1 flex flex-col justify-between min-h-[130px]">
                <div class="flex flex-col gap-1">
                  <div class="flex justify-between items-start gap-2">
                    <h2 class="text-sm font-semibold text-gray-900 leading-tight">{{ item.product.title }}</h2>
                    <button type="button" class="cart-remove text-gray-400 hover:text-black font-medium text-lg leading-none p-1" data-action="remove">×</button>
                  </div>
                  {% unless item.variant.title == 'Default Title' %}
                    {% assign variant_parts = item.variant.title | split: ' / ' %}
                    {% for part in variant_parts %}
                      <p class="text-xs text-gray-400">
                        {% if forloop.index == 2 %}Size: {{ part }}{% elsif forloop.index == 1 %}Color: {{ part }}{% endif %}
                      </p>
                    {% endfor %}
                  {% endunless %}
                </div>

                <div class="w-full flex items-center justify-between gap-4 mt-2">
                  <p class="line-total text-sm font-semibold text-gray-900">{{ item.final_line_price | money }}</p>
                  <div class="bg-[#D1D9CF] flex items-center rounded-sm">
                    <button type="button" class="qty-btn w-7 h-7 flex items-center justify-center text-sm text-gray-700 hover:bg-black/5" data-action="decrease">−</button>
                    <span class="text-sm font-medium text-gray-800 min-w-[20px] text-center">{{ item.quantity }}</span>
                    <button type="button" class="qty-btn w-7 h-7 flex items-center justify-center text-sm text-gray-700 hover:bg-black/5" data-action="increase">+</button>
                  </div>
                </div>
              </div>
            </div>

          {% endfor %}
        </div>
      </div>

      <div class="w-full lg:w-2/5 bg-gray-50/50 p-6 rounded-sm border border-gray-100 lg:sticky lg:top-6">
        <h3 class="text-lg font-semibold text-gray-900 mb-6 hidden lg:block">Order Details</h3>
        
        <div id="cart-summary" class="flex flex-col gap-4 text-sm md:text-base border-b border-gray-200 pb-6">
          <div class="flex justify-between">
            <p class="text-gray-600">Subtotal</p>
            <p id="cart-subtotal" class="font-medium text-gray-900">{{ cart.total_price | money }}</p>
          </div>

          <div class="flex justify-between text-gray-600">
            <p>Tax</p>
            <p id="cart-tax" class="font-medium text-gray-900">
              {% if cart.tax_price > 0 %}{{ cart.tax_price | money }}{% else %}Tk 50{% endif %}
            </p>
          </div>

          <div class="flex justify-between text-gray-600">
            <p>Shipping</p>
            <p class="font-medium text-gray-900">
              {% if cart.shipping_price > 0 %}{{ cart.shipping_price | money }}{% else %}Free{% endif %}
            </p>
          </div>
        </div>

        <div class="flex justify-between items-center py-4 text-base md:text-lg font-semibold text-gray-900">
          <p>Total Orders:</p>
          <p id="cart-total">{{ cart.total_price | money }}</p>
        </div>

        <p class="text-xs text-gray-500 font-medium leading-relaxed my-4">
          The total amount you pay includes all applicable customs duties & taxes. We guarantee no additional charges on delivery.
        </p>

        <div class="w-full flex justify-end mt-6">
          <a href="/checkout" class="w-full md:w-[184px] h-[44px] flex items-center justify-center bg-[#5A6D57] hover:bg-[#485746] text-white font-medium text-sm transition-colors tracking-wide rounded-sm">
            Next
          </a>
        </div>
      </div>

    </div>
  </main>

{% else %}

  <div class="min-h-[60vh] w-full flex flex-col justify-center items-center px-4 text-center font-montserrat gap-4">
    <h3 class="text-2xl font-semibold text-gray-900">Your cart is empty</h3>
    <p class="text-gray-500 text-sm max-w-[320px]">Start filling it up with your absolute favorite pieces today.</p>
    <a href="{{ routes.root_url }}" class="mt-2 inline-flex items-center justify-center px-6 h-[44px] bg-[#5A6D57] text-white text-sm font-medium hover:bg-[#485746] transition-colors rounded-sm">
      Shop Now
    </a>
  </div>

{% endif %}

<script>
document.addEventListener('DOMContentLoaded', function() {
  const backBtn = document.getElementById('back-btn');
  const continueShopping = document.getElementById('continue-shopping');

  if (backBtn) {
    backBtn.addEventListener('click', () => window.history.back());
  }
  if (continueShopping) {
    continueShopping.addEventListener('click', () => window.location.href = "{{ routes.all_products_collection_url }}");
  }

  function formatMoney(cents) {
    return '{{ cart.currency.iso_code }} ' + (cents / 100).toFixed(2);
  }

  function updateCart(key, quantity) {
    return fetch('/cart/change.js', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ id: key, quantity: quantity })
    }).then(r => r.json());
  }

  function rowsForKey(key) {
    return document.querySelectorAll(`[data-item-key="${key}"]`);
  }

  function refreshSummary(cart) {
    const subtotalEls = document.querySelectorAll('#cart-subtotal');
    const totalEls = document.querySelectorAll('#cart-total');
    
    subtotalEls.forEach(el => el.textContent = formatMoney(cart.total_price));
    totalEls.forEach(el => el.textContent = formatMoney(cart.total_price));

    if (cart.item_count === 0) {
      window.location.reload();
    }
  }

  // Handle Event Delegations for dynamic UI adjustments
  document.addEventListener('click', function(e) {
    // Remove Action Handles
    if (e.target.matches('.cart-remove')) {
      const row = e.target.closest('[data-item-key]');
      if (!row) return;
      const key = row.getAttribute('data-item-key');

      rowsForKey(key).forEach(el => {
        el.style.transition = 'opacity .25s ease';
        el.style.opacity = '0';
      });

      updateCart(key, 0).then(cart => {
        setTimeout(() => rowsForKey(key).forEach(el => el.remove()), 250);
        refreshSummary(cart);
      });
    }

    // Quantity Counter Action Handles (+ / -)
    if (e.target.matches('.qty-btn')) {
      const btn = e.target;
      const action = btn.getAttribute('data-action');
      const row = btn.closest('[data-item-key]');
      if (!row) return;
      const key = row.getAttribute('data-item-key');

      const container = btn.parentElement;
      const qtySpan = container ? container.querySelector('span') : null;
      if (!qtySpan) return;

      const currentQty = parseInt(qtySpan.textContent.trim(), 10) || 1;
      const targetQty = action === 'increase' ? currentQty + 1 : currentQty - 1;

      if (targetQty < 1) {
        const matchingRemove = row.querySelector('.cart-remove');
        if (matchingRemove) matchingRemove.click();
        return;
      }

      // Optimistically UI Change matching elements everywhere
      rowsForKey(key).forEach(el => {
        const span = el.querySelector('.qty-btn').parentElement.querySelector('span');
        if (span) span.textContent = targetQty;
        el.querySelectorAll('.qty-btn').forEach(b => b.disabled = true);
      });

      updateCart(key, targetQty).then(cart => {
        const item = cart.items.find(i => i.key === key);
        
        rowsForKey(key).forEach(el => {
          el.querySelectorAll('.qty-btn').forEach(b => b.disabled = false);
          const span = el.querySelector('.qty-btn').parentElement.querySelector('span');
          if (item && span) span.textContent = item.quantity;
          
          const totalEl = el.querySelector('.line-total');
          if (item && totalEl) totalEl.textContent = formatMoney(item.final_line_price);
        });

        refreshSummary(cart);
      }).catch(() => {
        // Rollback gracefully on errors
        rowsForKey(key).forEach(el => {
          el.querySelectorAll('.qty-btn').forEach(b => b.disabled = false);
          const span = el.querySelector('.qty-btn').parentElement.querySelector('span');
          if (span) span.textContent = currentQty;
        });
      });
    }
  });
});
</script>

